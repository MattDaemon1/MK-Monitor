{
  "name": "webfleet-monitor",
  "version": "1.0.0",
  "description": "Application locale d'audit, monitoring d'uptime et maintenance de parc web",
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.8.0"
  },
  "runtime": {
    "node": {
      "dependencies": {
        "express": "^4.21.2",
        "cheerio": "^1.0.0",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24"
      },
      "devDependencies": {
        "tsx": "^4.21.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0"
      }
    },
    "python": {
      "standard_libraries": [
        "urllib.request",
        "ssl",
        "socket",
        "json",
        "csv",
        "argparse",
        "re",
        "datetime"
      ],
      "optional_packages": [
        "requests>=2.31.0",
        "beautifulsoup4>=4.12.0"
      ]
    }
  }
}
